# Nole Code Environment Variables
# Copy to .env and fill in your values

# Primary: MiniMax API Key (free tier available)
# Get from: https://platform.minimaxi.com
MINIMAX_API_KEY=your_minimax_api_key_here

# Fallback: OpenRouter API Key (auto-fallback when MiniMax is overloaded)
# Get from: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# Fallback: OpenAI API Key
# OPENAI_API_KEY=sk-...

# Optional: Override the default model (default: MiniMax-M3)
# DEFAULT_MODEL=MiniMax-M3

# Optional: M3 tuning overrides
# Output ceiling per request (default: 16384; M3 supports up to 512K)
# NOLE_MAX_TOKENS=16384
# Context window before compaction triggers (default: 200000; M3 docs cite ~1M)
# NOLE_CONTEXT_WINDOW=200000

# Optional: Feature flags (comma-separated)
# NOLE_FEATURES=PERMISSION_RULES,AUTO_COMPACT,SESSION_COMPACT

# Optional: Enable debug mode
# DEBUG_TOOL=1

# Server configuration
# SERVER_PORT=18792
# API_KEY=your_random_api_key_here

# Buddy companion (set BUDDY= to enable)
# BUDDY=
# BUDDY_SPRITE=cat
